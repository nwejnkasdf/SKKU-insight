    @api path /health /admin /admin/* /auth /auth/* /consent /consent/* /onboarding /onboarding/* /topics /topics/* /recommendations /recommendations/* /documents /documents/* /interest /interest/* /events /events/* /feedback /feedback/*
    reverse_proxy @api api:8000

    reverse_proxy client:4173
}
