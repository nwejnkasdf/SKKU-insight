# SKKU InSight backend — env template
# 본 파일은 docs/ops/env-vars.md 의 §.env.example 골격을 그대로 옮긴 것이다.
# 비밀값은 .env 에서 채우고 git ignore.

# === Postgres ===
POSTGRES_DB=insight
POSTGRES_USER=insight
POSTGRES_PASSWORD=changeme-strong-password
DATABASE_URL=postgresql+asyncpg://insight:changeme-strong-password@postgres:5432/insight
PG_API_POOL_MIN=5
PG_API_POOL_MAX=30
PG_WORKER_POOL_MIN=2
PG_WORKER_POOL_MAX=10

# === Redis ===
REDIS_URL=redis://redis:6379/0
REDIS_URL_RATE_LIMIT=redis://redis:6379/1
REDIS_URL_QUEUE=redis://redis:6379/2
REDIS_URL_CACHE=redis://redis:6379/3

# === Auth ===
JWT_SECRET=change-this-to-64-char-random-secret-please-do-not-leave-default-here
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
JWT_ISSUER=skku-insight
BCRYPT_COST=12

# === LLM ===
# default mock (CI / 시연 안전). 실 OpenAI 호출 verification 시:
#   1. backend/.env (gitignored) 복사: `cp backend/.env.example backend/.env`
#   2. (시연) LLM_PROVIDER=codex_oauth 가 default 권고 — 호스트에서 `make codex-login`
#      1회 후 docker compose up. 사용자 본인 ChatGPT 구독 OAuth 활용 (비용 0).
#      OAuth refresh token 30일 유효 — 30일 후 또는 강제 revoke 시 재로그인 필요.
#   3. (정식 API) LLM_PROVIDER=openai 토글 + OPENAI_API_KEY=sk-... 채움.
#   4. (CI/fixture) LLM_PROVIDER=mock — 외부 호출 없이 deterministic fixture.
#   5. 본 파일 (.env.example) 은 placeholder 만 — 실 키 절대 commit 금지
LLM_PROVIDER=codex_oauth
# (v13 round 2, 2026-05-16) GPT-5.5 default — high/medium 동일 모델
LLM_MODEL_HIGH=gpt-5.5
LLM_MODEL_MEDIUM=gpt-5.5
# OpenAI reasoning_effort (gpt-5/o-series) — high/medium 슬롯 분리 (2026-05-18 fix).
# 가능 값: none, minimal, low, medium, high, xhigh.
# xhigh 는 latency + 5시간 ChatGPT 세션 한도 초과 우려로 미사용 (사용자 결정).
LLM_REASONING_EFFORT_HIGH=high
LLM_REASONING_EFFORT_MEDIUM=medium
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# === CodexOAuthProvider (2026-05-18 본문) ===
# LLM_PROVIDER=codex_oauth 토글 시 사용. backend 컨테이너에 codex CLI 설치 (Dockerfile)
# + 호스트 ~/.codex volume mount (docker-compose.yml). OpenAI 가 외부 도구 사용 공식 허용.
# 시연 부트 전 host 에서 `make codex-login` 1회 필요.
CODEX_OAUTH_TOKEN=
CODEX_CLI_PATH=codex
CODEX_SANDBOX_MODE=read-only
CODEX_WORKDIR=/tmp/codex-runtime
# cached (default, 안정) vs live (`--search` flag, 최신성). 시연 latency 안정성
# 우선이면 cached, 최신 논문/뉴스 요구면 live.
CODEX_WEB_SEARCH_MODE=cached
# codex service_tier — fast (default, 사용자 결정 2026-05-18, 시연 latency 최소화)
# / default / flex / scale / priority. fast 는 우선순위 큐 + 빠른 응답.
CODEX_SERVICE_TIER=fast
LLM_REQUEST_TIMEOUT_SECONDS=600
LLM_DAILY_TOKEN_BUDGET=1000000
LLM_MAX_CONCURRENT=8
LLM_MAX_CONCURRENT_PER_USER=2
LLM_SEMAPHORE_ACQUIRE_TIMEOUT_SECONDS=30

# === Clickbait (URL은 운영 시점 결정 — 호스팅·transport와 무관) ===
CLICKBAIT_SERVICE_URL=
CLICKBAIT_MODEL_NAME=ax-4.0-light-dora-clickbait-v1
# (v13 라운드 2026-05-11) A4 default 비활성. true 로 변경 시 A4 orchestrator post-filter 호출.
CLICKBAIT_ENABLED=false

# === Admin bootstrap ===
ADMIN_BOOTSTRAP_EMAIL=admin@skkuinsight.org
ADMIN_BOOTSTRAP_PASSWORD=Bootstrap-Initial-2026-Strong!
ADMIN_BOOTSTRAP_ROLE=super

# === Rate limit ===
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=3/hour
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_RUN_NOW=1/hour
RATE_LIMIT_REVOKE_CONSENT=5/hour
RATE_LIMIT_DELETE_ACCOUNT=1/hour
RATE_LIMIT_ONBOARDING=5/hour
RATE_LIMIT_ONBOARDING_UPDATE=10/hour
RATE_LIMIT_EVENTS=600/minute

# === Schedule ===
COLLECTION_CRON=0 3 * * *
COLLECTION_CRON_DEMO=0 * * * *
COLLECTION_PER_USER_PARALLEL=4
COLLECTION_GLOBAL_CONCURRENCY=8
COLLECTION_USER_JITTER_SECONDS=300
LIFECYCLE_EVALUATOR=hybrid_d
MERGE_EVALUATION_CRON=0 3 * * 1
# A6 daily decay (interest-bayesian.md §2). 18:00 UTC = 03:00 KST. lazy 미사용.
INTEREST_DECAY_CRON=0 18 * * *
# (v13 라운드 폐기, 2026-05-11) NaverBS4 어댑터 폐기로 cleanup 불필요. 값 보존돼도 무시.
NAVER_CLEANUP_CRON=0 17 * * *

# === Concurrency guards ===
EVENT_BATCH_SIZE=20
EVENT_BATCH_FLUSH_SECONDS=5
RECOMMENDATION_CACHE_TTL_SECONDS=3600
RECOMMENDATION_BUILD_LOCK_TTL_SECONDS=30
TRAVERSAL_USER_LOCK_TTL_SECONDS=10
CONSENT_CACHE_TTL_SECONDS=60

# === A8 Recommendation Engine (2026-05-17 결정 매트릭스, decisions.md §13) ===
# single-flight 폴링 (concurrency.md §2) — lock 보유 시 8s 까지 cache 결과 대기.
RECOMMENDATION_BUILD_POLL_TIMEOUT_SECONDS=8
RECOMMENDATION_BUILD_POLL_INTERVAL_SECONDS=0.2
# cold-start LLM cap (cold-start.md §비용 가드).
COLD_START_MAX_PER_DAY=100
COLD_START_MAX_PER_USER_LIFETIME=50
COLD_START_LLM_TIMEOUT_SECONDS=600
COLD_START_DEDUP_WINDOW_DAYS=30
# refresh endpoint slowapi rate limit (1 minute window).
RATE_LIMIT_DASHBOARD_REFRESH=20/minute
# GET /documents/{id}/summary LLM timeout (초). DB DocumentSummaryCache 가 1차 SOR.
DOCUMENT_SUMMARY_LLM_TIMEOUT_SECONDS=60
DOCUMENT_SUMMARY_SOURCE_ABSTRACT_MAX_CHARS=500

# === A6 Interest Bayesian (2026-05-17) ===
# 1-hop trace propagation. A7 본문 PR-3 (2026-05-17) 머지로 default true.
INTEREST_PROPAGATION_ENABLED=true
# onboarding boost (cluster +1.0 / 1-hop child +0.5) 가 자연 만료되는 active day.
INTEREST_BOOST_EXPIRY_ACTIVE_DAYS=14
# EventBuffer flush per-user mutex TTL (초). traversal_lock 과 별도.
INTEREST_BATCH_FLUSH_USER_LOCK_TTL_SECONDS=10
# dwell_tick Redis 카운터 TTL (초). 문서당 cap 4회 (≥2분).
DWELL_TICK_CAP_TTL_SECONDS=3600
DWELL_TICK_CAP_PER_DOCUMENT=4
# event idempotency payload-hash 캐시 TTL (초). DB UNIQUE 가 1차 SOR.
EVENT_DUPLICATE_CACHE_TTL_SECONDS=86400
# system_config seed 누락 시 동작 — true=fail-fast (default 운영), false=WARN+fallback.
SYSTEM_CONFIG_REQUIRED=true

# === A7 Leaf Lifecycle + Traversal (2026-05-17 결정 매트릭스 23건, decisions.md §12) ===
# --- leaf 식별 (emerging) ---
LEAF_LIFECYCLE_CRON=30 3 * * *
LEAF_EMERGING_MAX_PER_DAY=3
LEAF_EMERGING_CONFIDENCE_MIN=0.6
LEAF_EMERGING_SUPPORTING_DOCUMENTS_MIN=3
LEAF_EMERGING_LABEL_SIMILARITY_DEDUP=0.75
LEAF_EMERGING_INPUT_WINDOW_HOURS=24
LEAF_LLM_ANCHOR_RETRY_CAP=1
LEAF_LIFECYCLE_LOCK_TTL_SECONDS=60
# --- leaf 룰 기반 전이 ---
LEAF_ACTIVE_WINDOW_DAYS=7
LEAF_ACTIVE_MIN_DOCUMENTS=5
LEAF_ACTIVE_MIN_INTEREST_SIGNALS=2
LEAF_STALE_IDLE_DAYS=21
LEAF_ARCHIVED_IDLE_DAYS=90
LEAF_EMERGING_ARCHIVED_IDLE_DAYS=14
LEAF_REACTIVATION_WINDOW_DAYS=7
LEAF_REACTIVATION_MIN_DOCUMENTS=3
LEAF_REACTIVATION_MIN_INTEREST_SIGNALS=1
# --- leaf 병합 (LLM 주 1회, MERGE_EVALUATION_CRON 위에 정의) ---
LEAF_MERGE_JACCARD_MIN=0.6
LEAF_MERGE_LABEL_SIMILARITY_MIN=0.75
LEAF_MERGE_MAX_PER_USER=50
MERGE_EVALUATION_LOCK_TTL_SECONDS=120
# --- trace operation (extend/retract/split/archive/merge — 5 operation, merge 신규) ---
TRACE_ACTIVE_CAP=10
TRACE_PATH_DEPTH_CAP=8
TRACE_STALE_IDLE_DAYS=21
TRACE_STALE_THRESHOLD_SCORE=0.30
TRACE_RETRACT_AFTER_STALE_DAYS=14
TRACE_ARCHIVE_AFTER_STALE_DAYS=90
TRACE_EXTEND_MIN_INTERACTIONS=5
TRACE_SPLIT_WINDOW_DAYS=7
# A7 신규: trace merge 룰 trigger 임계 (path overlap ≥3).
TRACE_MERGE_PATH_OVERLAP_MIN=3
# A7 신규: daily trace merge cron (18 UTC = 03 KST, A6 decay 와 같은 시각).
TRACE_MERGE_CRON=0 18 * * *
TRACE_MERGE_LOCK_TTL_SECONDS=120
# --- propagation (cso-topic-traversal.md §4) ---
PROPAGATION_HOP_DECAY=0.5
PROPAGATION_MAX_HOPS=4

# === A8-v2 UserProfile + Discovery Fusion + Reincarnation (2026-05-19, decisions.md §15) ===
# daily LLM cron — 사용자별 1회 archive×current cross-product 융합 + reincarnation seed.
# discovery slot 2 (Fusion 1 + Reincarnation 1) 의 input SOR.
USER_PROFILE_CRON=0 19 * * *
# (C-53, 2026-05-24) Fusion bridge BFS / Reincarnation softmax sampling.
REINCARNATION_SAMPLING_TEMPERATURE=0.3
FUSION_BRIDGE_PATH_TOP_K=5
FUSION_BRIDGE_MAX_HOPS=3
# discovery/adjacent → core promotion 주 1회 cron. UserEvent.save 7-day window.
WEEKLY_PROMOTION_CRON=0 18 * * 0
USER_PROFILE_ARCHIVE_SCORE_TAIL_MIN=0.6
USER_PROFILE_GENERATOR_VERSION=v1
USER_PROFILE_INPUT_ARCHIVE_MAX=8
USER_PROFILE_REINCARNATION_GAP_DAYS_MIN=7
USER_PROFILE_LOCK_TTL_SECONDS=360
USER_PROFILE_CACHE_TTL_SECONDS=3600
# (C-54, 2026-05-24) Fusion bridge_cso 영역 fresh Document fetch — UserProfile cron 안.
FUSION_FETCH_ENABLED=true
FUSION_FETCH_MAX_DOCUMENTS=5
FUSION_FETCH_RECENT_URLS_WINDOW_DAYS=30

# === External ===
# (v13 라운드 dead, 2026-05-11) source 어댑터 6종 폐기로 본 두 env 미사용.
# 향후 어댑터 재도입 가능성 위해 보존만 (config 등록도 유지).
OPENALEX_POLITE_EMAIL=dev@insight.test
SEMANTIC_SCHOLAR_API_KEY=
# CSO 3.5 다운로드 URL (A3, decision-backlog P1-5). 첫 부트 전 `make seed-cso-cache`
# (FILE 생략) 한 번 실행 권장 — git-tracked `data/cso/CSO.3.5.csv` (~26MB) 가 컨테이너
# cso_cache volume 에 카피되어 import_cso 가 캐시 우선 (URL 미접근, 오프라인 시연 가능).
# 다른 버전 사용 시: `make seed-cso-cache FILE=~/Downloads/CSO.X.Y.csv`. C-46, 2026-05-24.
CSO_DOWNLOAD_URL=https://cso.kmi.open.ac.uk/downloads/CSO.3.5.csv

# === CORS / hosts ===
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173,http://127.0.0.1:5173,app://insight
API_PUBLIC_BASE=http://localhost:8000
LOG_LEVEL=INFO
STRUCTLOG_RENDER=json

# === Worker 병렬 정책 (decision-backlog C-20) ===
# uvicorn worker process 수. 데모 default 1. N>1 시 LLM 동시성은 Redis 분산 (자동),
# DB pool 합산은 운영자 책임 (PG_API_POOL_MAX * UVICORN_WORKERS ≤ max_connections).
UVICORN_WORKERS=1
