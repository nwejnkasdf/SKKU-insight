# clickbait_module 자체 env. backend의 .env와 별개.

# DoRA 어댑터를 base에 머지한 결과 디렉토리 (scripts/merge_adapter.py 출력).
# vLLM이 본 디렉토리를 일반 base 모델처럼 로드한다.
MERGED_MODEL_PATH=

# 원본 DoRA 어댑터 디렉토리 — 머지 스크립트의 입력 + 부트 시 진단 로깅용.
ADAPTER_PATH=clickbait_module/adapter

# === vLLM (A100 40GB 단일 GPU 가정) ===
DTYPE=bfloat16
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.9
MAX_NUM_SEQS=256
ENABLE_PREFIX_CACHING=true
TENSOR_PARALLEL_SIZE=1
LOGPROBS_TOPK=20

# === 분류 ===
CLICKBAIT_THRESHOLD=0.5
CLICKBAIT_MODEL_NAME=ax-4.0-light-dora-clickbait-v1
CATEGORY_FALLBACK=ETC

# === 운영 ===
STUB_MODE=false
LOG_LEVEL=INFO
